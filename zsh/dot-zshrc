# ~/.zshrc — merged final
# ═══════════════════════════════════════════════════════════════
#  Startup order matters:
#  PATH → zinit → zsh-completions → compinit (sync) → turbo plugins
#  Sync compinit is REQUIRED: bun/_bun, uv, uvx call compdef at source time.
# ═══════════════════════════════════════════════════════════════

### ────── Auto Start Zellij ────────────────────────────────────────
if [[ -z "$ZELLIJ" ]]; then
    if [[ "$ZELLIJ_AUTO_ATTACH" == "true" ]]; then
        zellij attach -c
    else
        zellij
    fi

    if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]]; then
        exit
    fi
fi

### ── PATH ──────────────────────────────────────────────
# typeset -U = unique entries forever; replaces every manual PATH check
typeset -U path PATH
path+=(
  "$HOME/.local/bin"
  "$HOME/.local/share/fnm"
  /usr/local/go/bin
  "$HOME/go/bin"
)

export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/.local/share/pnpm"
# Prepend so they win over system copies.
# NOTE: pnpm puts binaries directly in $PNPM_HOME — there is no /bin subdir.
path=("$BUN_INSTALL/bin" $path)
[[ -d $PNPM_HOME ]] && path=("$PNPM_HOME/bin" $path)

### ── System detection (no subprocess) ──────────────────
SYS_ARCH="${OSTYPE%%[^a-z]*}_${CPUTYPE}"   # → linux_x86_64 | darwin_arm64

### ── Zinit bootstrap ───────────────────────────────────
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [[ ! -d $ZINIT_HOME ]]; then
  mkdir -p "${ZINIT_HOME:h}"
  git clone --depth 1 https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "${ZINIT_HOME}/zinit.zsh"

### ── zsh-completions + compinit (synchronous — order matters) ──
# blockf: fpath only, must precede compinit; atpull keeps completions fresh
zinit ice depth=1 blockf atpull'zinit creinstall -q .'
zinit light zsh-users/zsh-completions

# Full rebuild if dump is missing OR older than 24h; instant -C path otherwise.
# -u avoids Homebrew "insecure directories" prompts.
autoload -Uz compinit
_zcd="${ZDOTDIR:-$HOME}/.zcompdump"
if [[ ! -f $_zcd || -n $_zcd(#qN.mh+24) ]]; then
  compinit -u -d "$_zcd"
else
  compinit -C -d "$_zcd"
fi
unset _zcd

# Register zinit's own completion (compinit already ran)
autoload -Uz _zinit && (( ${+_comps} )) && _comps[zinit]=_zinit

### ── Plugins, turbo mode (load right after first prompt) ──
# ORDER: fzf-tab after compinit, before autosuggestions/highlighting
zinit ice wait lucid depth=1
zinit light Aloxaf/fzf-tab

# zicdreplay ONLY — compinit already ran synchronously above;
# zicompinit here would run it a second time.
zinit wait lucid light-mode depth=1 for \
  atinit"zicdreplay" \
      zdharma-continuum/fast-syntax-highlighting \
  atload"_zsh_autosuggest_start" \
      zsh-users/zsh-autosuggestions

zinit wait lucid for \
  OMZP::git \
  OMZP::sudo \
  OMZP::extract \
  OMZP::copypath

# Eager (NOT turbo): its widgets are bound below at startup, so it must
# exist immediately. Tiny plugin — costs ~10ms.
zinit ice depth=1; zinit light zsh-users/zsh-history-substring-search

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1

### ── Keybindings (vi mode) ─────────────────────────────
# bindkey -v
# KEYTIMEOUT=10
# bindkey -M viins 'jk' vi-cmd-mode
# bindkey -M viins '^?' backward-delete-char
# bindkey -M viins '^H' backward-delete-char

zmodload zsh/terminfo    # exposes $terminfo (no-op if already loaded)

# # Substring history search — terminfo keys, hardcoded fallback if entry missing
# bindkey "${terminfo[kcuu1]:-^[[A}" history-substring-search-up
# bindkey "${terminfo[kcud1]:-^[[B}" history-substring-search-down

bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

bindkey '^P'   history-substring-search-up
bindkey '^N'   history-substring-search-down
# bindkey -M vicmd 'k' history-substring-search-up
# bindkey -M vicmd 'j' history-substring-search-down

# Ctrl+Left/Right — jump to previous/next word
# kLFT5/kRIT5 = Ctrl+arrow in terminfo; ^[[1;5D/^[[1;5C = what xterm/kitty/alacritty send
bindkey "${terminfo[kLFT5]:-^[[1;5D}" backward-word
bindkey "${terminfo[kRIT5]:-^[[1;5C}" forward-word

bindkey "${terminfo[khome]:-^[[H}" beginning-of-line      # Home
bindkey "${terminfo[kend]:-^[[F}"  end-of-line            # End
bindkey "${terminfo[kdch1]:-^[[3~}" delete-char           # Delete


# Edit command line in $EDITOR: v in normal mode (or Ctrl-X Ctrl-E)
autoload -Uz edit-command-line; zle -N edit-command-line
# bindkey -M vicmd v edit-command-line
bindkey '^X^E' edit-command-line

# bash-style word boundaries: Ctrl-w / Alt-b / Alt-f stop at / and .
autoload -Uz select-word-style && select-word-style bash

### ── History ───────────────────────────────────────────
HISTSIZE=50000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt sharehistory               # share + append across sessions
setopt hist_ignore_space          # leading space → not recorded (secrets)
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_find_no_dups
setopt hist_expire_dups_first
setopt hist_reduce_blanks
setopt hist_verify                # show !! expansion before executing
setopt extended_history           # timestamps in history

### ── Quality of life ───────────────────────────────────
setopt autocd                     # type a dir name to cd into it
setopt interactive_comments       # # comments work at the prompt
setopt extended_glob
setopt no_beep
setopt auto_pushd pushd_ignore_dups pushd_minus   # cd stacks dirs: `dirs -v`, `cd -2`

export EDITOR="${commands[nvim]:+nvim}"
export EDITOR="${EDITOR:-vim}"
export VISUAL="$EDITOR"

### ── Completion styling ────────────────────────────────
[[ -z $LS_COLORS ]] && (( $+commands[dircolors] )) && eval "$(dircolors -b)"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompcache"
# case-insensitive first, then partial-word fallback
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no                     # let fzf-tab own the menu
zstyle ':completion:*' verbose yes
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '[%d]'  # plain text — fzf-tab requirement
zstyle ':completion:*:warnings'     format '── no matches ──'
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:complete:cd:*' fzf-preview \
  'eza -1 --color=always --icons $realpath 2>/dev/null || ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview \
  'eza -1 --color=always --icons $realpath 2>/dev/null || ls --color $realpath'

### ── Aliases ───────────────────────────────────────────
(( $+commands[nvim] )) && alias vim='nvim'

# Plain fallbacks per OS; eza overrides them below if installed
if [[ $SYS_ARCH == linux* ]]; then
  alias ls='ls --color' ll='ls -lah --color'
else
  alias ls='ls -G' ll='ls -lahG'
fi

if (( $+commands[eza] )); then
  # local _tree_excl='--git-ignore --ignore-glob=.git\|node_modules\|.cache\|target\|dist'
  local _tree_excl='--git-ignore'
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -l --icons --git --group-directories-first'
  alias la='eza -la --icons --git --group-directories-first'
  alias lt="eza --tree --icons --level=2 $_tree_excl"
  alias lat="eza -a --tree --icons --level=2 $_tree_excl"
  alias ltt="eza --tree --icons --level=3 $_tree_excl"
  alias latt="eza -a --tree --icons --level=3 $_tree_excl"
  unset _tree_excl
fi

(( $+commands[bat]  )) && alias cat='bat --paging=never'
(( $+commands[rg]   )) && alias grep='rg'
(( $+commands[fd]   )) && alias find='fd'
(( $+commands[btop] )) && alias top='btop'

alias zshrc='$EDITOR ~/.zshrc'
alias reload='exec zsh'
alias path='print -l $path'
alias d='dirs -v'

### ── evalcache: cache `eval "$(tool init)"` output for 24h ──
# Saves ~50-150ms/start. After upgrading a tool: rm -rf ~/.cache/zsh/evalcache
evalcache() {
  local name="$1"; shift
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/evalcache"
  local cache="$dir/$name.zsh"
  [[ -d $dir ]] || mkdir -p "$dir"
  if [[ ! -s $cache || -n $cache(#qN.mh+24) ]]; then
    # temp file first: a failing command must not clobber a good cache
    "$@" >| "$cache.tmp" 2>/dev/null && mv "$cache.tmp" "$cache"
  fi
  [[ -s $cache ]] && source "$cache"
}

### ── Shell integrations ────────────────────────────────
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'
if (( $+commands[fd] )); then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

(( $+commands[fzf] ))        && evalcache fzf        fzf --zsh
(( $+commands[oh-my-posh] )) && evalcache oh-my-posh oh-my-posh init zsh --config "$HOME/.config/ohmyposh/custom-atomicBit.toml"
(( $+commands[zoxide] ))     && evalcache zoxide     zoxide init zsh --cmd cd # --cmd cd replaces `alias cd=z` + gives `cdi` (interactive)
(( $+commands[uv] ))         && evalcache uv         uv  generate-shell-completion zsh
(( $+commands[uvx] ))        && evalcache uvx        uvx --generate-shell-completion zsh

### ── fnm (Node version manager) ───────────────────────
if (( $+commands[fnm] )); then
  # explicit --shell skips process-tree detection (faster per fnm docs);
  # recursive = find .nvmrc/.node-version in parent dirs (monorepos);
  # quiet = no "Using Node vX" banner on every cd
  evalcache fnm fnm env --use-on-cd --shell zsh --version-file-strategy=recursive --log-level=quiet
  evalcache fnm-completions fnm completions --shell zsh
fi

### ── bun completions ───────────────────────────────────
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

### ── Local env (uv installer drops this) ───────────────
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"

# kimi-code
export PATH="/home/jaw/.kimi-code/bin:$PATH"
